# =========================================================
# SuperAI Hub - Environment Configuration (.env)
# =========================================================

# Google Gemini API Key (Optional platform fallback; users provide their own BYOK key)
GEMINI_API_KEY=

# WhatsApp Engine Service Port
PORT=4000

# Frontend Web Origin URL (for CORS)
WEB_ORIGIN=http://localhost:5173

# Database URL (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/superai_hub

# Payment Gateway Configuration (OpayBD / SSLCOMMERZ / bKash)
OPAYBD_API_KEY=
OPAYBD_CLIENT_SECRET=
