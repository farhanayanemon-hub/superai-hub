# ==============================================================================
# SuperAI Hub (ezboagents.com) - Production Environment Configuration
# ==============================================================================

# Google AI Studio Gemini API Key (Optional server fallback - users BYOK)
GEMINI_API_KEY=

# Railway WhatsApp Engine URL (Defaults to deployed Railway engine if unset)
WHATSAPP_ENGINE_URL=https://whatsapp-engine-production-04f4.up.railway.app

# Google OAuth 2.0 Client ID (Optional for Google Sign In)
PUBLIC_GOOGLE_CLIENT_ID=

# SMTP Server Configuration (For sending welcome & transactional emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@ezboagents.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="SuperAI Hub" <support@ezboagents.com>
SMTP_SECURE=false
